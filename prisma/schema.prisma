generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BiasRating {
  LEFT
  LEAN_LEFT
  CENTER
  LEAN_RIGHT
  RIGHT
  UNKNOWN
}

enum ArticleStatus {
  PENDING
  EXTRACTED
  FAILED
  PAYWALLED
}

model Source {
  id          String     @id @default(cuid())
  name        String
  domain      String     @unique
  logoUrl     String?
  rssFeeds    String[]
  bias        BiasRating @default(UNKNOWN)
  country     String     @default("US")
  language    String     @default("en")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  articles    Article[]

  @@index([bias])
}

model Article {
  id              String        @id @default(cuid())
  url             String        @unique
  title           String
  description     String?
  author          String?
  publishedAt     DateTime?
  extractedText   String?       @db.Text
  extractedImage  String?
  imageAlt        String?
  readingTimeMin  Int?
  status          ArticleStatus @default(PENDING)
  sourceId        String
  source          Source        @relation(fields: [sourceId], references: [id])
  storyArticles   StoryArticle[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sourceId])
  @@index([publishedAt])
  @@index([status])
}

model StoryCluster {
  id            String         @id @default(cuid())
  title         String
  summary       String?        @db.Text
  topicId       String?
  topic         Topic?         @relation(fields: [topicId], references: [id])
  imageUrl      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  storyArticles StoryArticle[]

  @@index([topicId])
  @@index([createdAt])
}

model StoryArticle {
  id             String       @id @default(cuid())
  storyClusterId String
  articleId      String
  storyCluster   StoryCluster @relation(fields: [storyClusterId], references: [id], onDelete: Cascade)
  article        Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  addedAt        DateTime     @default(now())

  @@unique([storyClusterId, articleId])
  @@index([storyClusterId])
  @@index([articleId])
}

model Topic {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  description   String?
  emoji         String?
  storyClusters StoryCluster[]
  createdAt     DateTime       @default(now())
}
